index 0000000..f38e640
--- /dev/null
+++ b/packages/tui/test/child-composer-steer.test.tsx
@@ -0,0 +1,172 @@
+import { expect, test } from "bun:test"
+import type { TestRendererSetup } from "@opentui/core/testing"
+import { createAppFixture } from "./fixture/app"
+import { directory, json } from "./fixture/tui-client"
+import { TuiKeybind } from "../src/config/keybind"
+
+/**
+ * Regression coverage for the child-session inline steer composer.
+ *
+ * Before the patch, viewing a child session force-opened the subagent Composer
+ * picker and rendered `{null}` instead of the host `<Prompt>`, so there was no
+ * free-text composer. After the patch:
+ *   - a child session renders the normal Prompt and it submits to the CHILD
+ *     (delivery defaults to "steer"), and
+ *   - a parent/main session is unchanged (no steer placeholder, submits to itself).
+ */
+
+const base = {
+  projectID: "project",
+  agent: "build",
+  model: { providerID: "demo", id: "model" },
+  location: { directory },
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  time: { created: 0, updated: 0 },
+}
+const parent = { ...base, id: "ses_parent", title: "Parent session" }
+const child = { ...base, id: "ses_child", title: "Child session", parentID: parent.id, agent: "general" }
+
+type PromptCall = { sessionID: string; body: { text?: string; delivery?: string } }
+
+const config = { animations: false, tabs: { mode: "off" as const }, session: { sidebar: "hide" as const } }
+
+/** A colour reads as blue when the blue channel clearly dominates red/green. */
+function isBlue(color: { toInts(): [number, number, number, number] }) {
+  const [r, g, b, a] = color.toInts()
+  return a > 0 && b > r + 24 && b > g + 16
+}
+
+// The composer and its metadata sit at the bottom of the frame; the transcript
+// above it may legitimately contain agent names, so assertions stay scoped.
+type CapturedLine = ReturnType<TestRendererSetup["captureSpans"]>["lines"][number]
+
+function composerLines(setup: TestRendererSetup): CapturedLine[] {
+  return setup.captureSpans().lines.slice(-12)
+}
+
+function composerText(setup: TestRendererSetup) {
+  return composerLines(setup)
+    .map((line) => line.spans.map((span) => span.text).join(""))
+    .join("\n")
+}
+
+function composerHasBlue(setup: TestRendererSetup) {
+  return composerLines(setup)
+    .flatMap((line) => line.spans)
+    .some((span) => isBlue(span.bg))
+}
+
+async function boot(sessionID: string) {
+  const promptSeen = Promise.withResolvers<PromptCall>()
+  const switched: string[] = []
+  const location = { directory, project: { id: "project", directory, canonical: directory } }
+  const setup = await createAppFixture({
+    args: { sessionID },
+    config,
+    fetch: async (url, request) => {
+      if (url.pathname === "/api/session") {
+        if (url.searchParams.has("parentID")) return json({ data: [], cursor: {} })
+        return json({ data: [parent, child], cursor: {} })
+      }
+      if (url.pathname === `/api/session/${parent.id}`) return json({ data: parent })
+      if (url.pathname === `/api/session/${child.id}`) return json({ data: child })
+      const promptMatch = url.pathname.match(/^\/api\/session\/([^/]+)\/prompt$/)
+      if (promptMatch && request.method === "POST") {
+        const body = (await request.json()) as PromptCall["body"]
+        const call = { sessionID: promptMatch[1], body }
+        promptSeen.resolve(call)
+        return json({
+          data: {
+            id: (body as { id?: string }).id,
+            sessionID: promptMatch[1],
+            type: "user",
+            time: { created: 10 },
+            payload: { text: body.text },
+            delivery: body.delivery ?? "steer",
+          },
+        })
+      }
+      if (/^\/api\/session\/[^/]+\/message$/.test(url.pathname)) return json({ data: [], cursor: {} })
+      if (/^\/api\/session\/[^/]+\/inbox$/.test(url.pathname)) return json({ data: [] })
+      const agentMatch = url.pathname.match(/^\/api\/session\/([^/]+)\/agent$/)
+      if (agentMatch && request.method === "POST") {
+        switched.push(agentMatch[1])
+        return new Response(null, { status: 204 })
+      }
+      if (url.pathname === "/api/agent")
+        return json({
+          location,
+          data: [
+            { id: "build", name: "Build", mode: "primary", hidden: false, permissions: [] },
+            { id: "general", name: "General", mode: "subagent", hidden: false, permissions: [] },
+          ],
+        })
+      if (url.pathname === "/api/provider") return json({ location, data: [{ id: "demo", name: "Demo" }] })
+      if (url.pathname === "/api/model")
+        return json({ location, data: [{ id: "model", providerID: "demo", name: "Demo Model", variants: [] }] })
+      return undefined
+    },
+  })
+  await setup.ready
+  return { setup, promptSeen, switched }
+}
